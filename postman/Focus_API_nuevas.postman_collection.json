              "script": {
                "type": "text/javascript",
                "exec": [
                  "const archivo = pm.request.body.formdata.find((p) => p.key === 'archivo');",
                  "const elegido = archivo && archivo.src && String(archivo.src).length > 0;",
                  "if (!elegido) {",
                  "  pm.test.skip('Elige una imagen en Body → form-data para probar la subida', () => {});",
                  "} else {",
                  "  pm.test('Status 201', () => pm.expect(pm.response.code).to.eql(201));",
                  "  pm.test('Guarda el enlace de la foto', () => pm.expect(pm.response.json().foto_url).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
